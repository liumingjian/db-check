# Copy to web/.env.local when running the console outside PM2. Next.js inlines
# NEXT_PUBLIC_* at build time, so set them before `npm run build`.
# docs/deployment.md explains every setting.

# real (default when unset) talks to db-web; mock keeps demo data in the
# browser and is what `npm run dev:mock` sets.
NEXT_PUBLIC_API_MODE=real

# Full origin of db-web as the browser reaches it. Unset: a page on :3000
# calls the same host on NEXT_PUBLIC_API_PORT (default 8080), otherwise the
# page's own origin.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8080
# NEXT_PUBLIC_API_PORT=8080
