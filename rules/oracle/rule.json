        {"check_id": "6.4", "name": "最近成功数据备份时间", "source_module": "db_backup", "extract": {"json_path": "db.backup.successful_backup_age_hours", "aggregation": "raw"}, "thresholds": {"warning": {"operator": ">", "value": 48}, "critical": {"operator": ">", "value": 168}}, "optimization_advice": "超过 48 小时告警，超过 7 天或没有成功 DB FULL/DB INCR 记录为严重。此为本项目保守基线，非已验证的双平台阈值。请核对控制文件保留期、RMAN catalog 和备份恢复验证。"},
        {"check_id": "6.5", "name": "最近七天 RMAN 失败作业", "source_module": "db_backup", "extract": {"json_path": "db.backup.failed_jobs", "aggregation": "raw"}, "evaluation": {"method": "row_count", "thresholds": {"critical": {"operator": ">", "value": 0}}}, "optimization_advice": "请 DBA 检查 FAILED 或 COMPLETED WITH ERRORS 的 RMAN 日志，补做备份并验证恢复。"},
        {"check_id": "6.6", "name": "闪回数据库状态", "source_module": "db_backup", "extract": {"json_path": "db.backup.flashback_on", "aggregation": "raw"}, "thresholds": {"warning": {"operator": "!=", "value": "YES"}}, "optimization_advice": "请 DBA 依据恢复目标评估开启 Flashback Database 和恢复区容量；RESTORE POINT ONLY 不等于持续闪回开启。"},
