{
  "rule_meta": {
    "schema_version": "1.0",
    "rule_version": "1.0.0",
    "rule_name": "Oracle 数据库巡检规则模板",
    "db_type": "oracle",
    "target_versions": ["11gR2", "12c", "19c", "21c", "23ai"],
    "updated_at": "2026-10-03",
    "target": "自建 Oracle 11gR2 / 12c（含 18c）/ 19c / 21c / 23ai；11gR2、19c 本实现 smoke 待验证，12c、21c、23ai 未经过容器验证",
    "total_checks": 70,
    "priority_summary": {
      "P0": 23,
      "P1": 18,
      "P2": 11,
      "P3": 1
    }
  },
  "dimensions": [
    {
      "dimension_id": 1,
      "name": "操作系统资源",
      "checks": [
        {
          "check_id": "1.1",
          "name": "CPU 使用率",
          "priority": "P1",
          "source_module": "os",
          "extract": {"json_path": "os.cpu.samples[*].usage_percent", "aggregation": "avg"},
          "thresholds": {"warning": {"operator": ">", "value": 70}, "critical": {"operator": ">", "value": 90}},
          "optimization_advice": "排查高 CPU SQL 与异常进程"
        },
        {
          "check_id": "1.2",
          "name": "内存使用率",
          "priority": "P1",
          "source_module": "os",
          "extract": {"json_path": "os.memory.samples[*].usage_percent", "aggregation": "avg"},
          "thresholds": {"warning": {"operator": ">", "value": 85}, "critical": {"operator": ">", "value": 95}},
          "optimization_advice": "检查 SGA/PGA 与主机内存分配"
        },
        {
          "check_id": "1.3",
          "name": "磁盘使用率",
          "priority": "P0",
          "source_module": "os",
          "extract": {"json_path": "os.filesystem.samples[*].mountpoints[*].usage_percent", "aggregation": "max"},
          "thresholds": {"warning": {"operator": ">", "value": 80}, "critical": {"operator": ">", "value": 90}},
          "optimization_advice": "检查数据目录、归档目录与备份目录容量"
        }
      ]
    },
    {
      "dimension_id": 2,
      "name": "实例与架构基础",
      "checks": [
        {
          "check_id": "2.1",
          "name": "RAC 架构识别",
          "priority": "P3",
          "source_module": "db_basic",
          "extract": {"json_path": "db.basic_info.is_rac", "aggregation": "raw"},
          "evaluation": {"method": "info"},
          "optimization_advice": "确认单实例或 RAC 架构与实际部署一致"
        },
        {
          "check_id": "2.2",
          "name": "SPFILE 配置",
          "priority": "P1",
          "source_module": "db_basic",
          "extract": {"json_path": "db.config_check.spfile", "aggregation": "raw"},
          "thresholds": {"normal": {"operator": "!=", "value": ""}, "warning": {"operator": "==", "value": ""}},
          "optimization_advice": "建议使用 spfile 统一管理实例参数"
        },
        {
          "check_id": "2.3",
          "name": "ARCHIVELOG 模式",
          "priority": "P0",
          "source_module": "db_basic",
          "extract": {"json_path": "db.backup.archive_log_mode", "aggregation": "raw"},
          "thresholds": {"normal": {"operator": "==", "value": "ARCHIVELOG"}, "critical": {"operator": "!=", "value": "ARCHIVELOG"}},
          "optimization_advice": "生产库必须开启归档模式以保证可恢复性"
        }
      ]
    },
    {
      "dimension_id": 3,
      "name": "存储与表空间",
      "checks": [
        {
          "check_id": "3.1",
          "name": "表空间使用率",
          "priority": "P0",
          "source_module": "db_storage",
          "extract": {"json_path": "db.storage.tablespace_usage.items[*].real_percent", "aggregation": "max"},
          "thresholds": {"warning": {"operator": ">", "value": 80}, "critical": {"operator": ">", "value": 90}},
          "optimization_advice": "及时扩容高水位表空间或清理历史数据"
        },
        {
          "check_id": "3.2",
          "name": "待恢复数据文件",
          "priority": "P0",
          "source_module": "db_storage",
          "extract": {"json_path": "db.storage.recover_files", "aggregation": "raw"},
          "evaluation": {"method": "row_count", "thresholds": {"normal": {"operator": "==", "value": 0}, "critical": {"operator": ">", "value": 0}}},
          "optimization_advice": "尽快处理 recover file，避免数据文件异常未恢复"
        },
        {
          "check_id": "3.3",
          "name": "无效对象数量",
          "priority": "P1",
          "source_module": "db_storage",
          "extract": {"json_path": "db.storage.invalid_objects", "aggregation": "raw"},
          "evaluation": {"method": "row_count", "thresholds": {"normal": {"operator": "==", "value": 0}, "warning": {"operator": ">", "value": 0}}},
          "optimization_advice": "重新编译无效对象并排查依赖缺失"
        },
        {
          "check_id": "3.4",
          "name": "不可用索引数量",
          "priority": "P1",
          "source_module": "db_storage",
          "extract": {"json_path": "db.storage.invalid_indexes", "aggregation": "raw"},
          "evaluation": {"method": "row_count", "thresholds": {"normal": {"operator": "==", "value": 0}, "warning": {"operator": ">", "value": 0}}},
          "optimization_advice": "重建 unusable 索引，避免执行计划退化"
        },
        {
          "check_id": "3.5", "name": "临时表空间活跃使用率", "priority": "P0", "source_module": "db_storage",
          "extract": {"json_path": "db.storage.temp_usage_max_pct", "aggregation": "raw"},
          "thresholds": {"warning": {"operator": ">", "value": 80}, "critical": {"operator": ">", "value": 90}},
          "optimization_advice": "请 DBA 检查排序和临时段使用 SQL，按临时文件自动扩展上限确认容量，必要时增加 TEMPFILE。"
        },
        {
          "check_id": "3.6", "name": "SYSAUX 使用率", "priority": "P1", "source_module": "db_storage",
          "extract": {"json_path": "db.storage.sysaux_usage_pct", "aggregation": "raw"},
          "thresholds": {"warning": {"operator": ">", "value": 85}, "critical": {"operator": ">", "value": 90}},
          "optimization_advice": "请 DBA 检查 SYSAUX 各组件占用，使用组件支持的清理方法或扩容，勿直接删除系统对象。"
        },
        {
          "check_id": "3.7", "name": "最大段容量占比", "priority": "P2", "source_module": "db_storage",
          "extract": {"json_path": "db.storage.largest_segment_usage_pct", "aggregation": "raw"},
          "thresholds": {"warning": {"operator": ">", "value": 80}, "critical": {"operator": ">", "value": 90}},
          "optimization_advice": "查看最大段明细，确认业务增长与数据保留计划；该占比以所在表空间自动扩展最大容量为分母。"
        },
        {
          "check_id": "3.8", "name": "回收站可回收空间", "priority": "P2", "source_module": "db_storage",
          "extract": {"json_path": "db.storage.recyclebin_size_gb", "aggregation": "raw"},
          "thresholds": {"normal": {"operator": "==", "value": 0}, "warning": {"operator": ">", "value": 0}},
          "optimization_advice": "请 DBA 确认回收站对象不再需要闪回恢复后，按业务审批清理对应对象以释放空间。存在可回收空间是提示，不表示容量不足。"
        }
      ]
    },
    {
      "dimension_id": 4,
      "name": "性能与 SQL",
      "checks": [
        {
          "check_id": "4.1",
          "name": "Redo 切换频率",
          "priority": "P2",
          "source_module": "db_perf",
          "extract": {"json_path": "db.performance.redo_switch_daily.items[*].switch_count", "aggregation": "max"},
          "thresholds": {"warning": {"operator": ">", "value": 50}, "critical": {"operator": ">", "value": 100}},
          "optimization_advice": "检查日志文件大小、批量写入与 checkpoint 行为"
        },
        {
          "check_id": "4.2",
          "name": "高耗时 SQL",
          "priority": "P1",
          "source_module": "db_sql",
          "extract": {"json_path": "db.sql_analysis.top_sql_by_elapsed_time", "aggregation": "raw"},
          "evaluation": {"method": "row_count", "thresholds": {"normal": {"operator": "==", "value": 0}, "warning": {"operator": ">", "value": 0}}},
          "optimization_advice": "重点分析 elapsed time Top SQL 的执行计划与绑定变量"
        },
        {
          "check_id": "4.3",
          "name": "高逻辑读 SQL",
          "priority": "P2",
          "source_module": "db_sql",
          "extract": {"json_path": "db.sql_analysis.top_sql_by_buffer_gets", "aggregation": "raw"},
          "evaluation": {"method": "row_count", "thresholds": {"normal": {"operator": "==", "value": 0}, "warning": {"operator": ">", "value": 0}}},
          "optimization_advice": "检查 buffer gets Top SQL 是否存在大范围扫描"
        },
        {
          "check_id": "4.4",
          "name": "高物理读 SQL",
          "priority": "P2",
          "source_module": "db_sql",
          "extract": {"json_path": "db.sql_analysis.top_sql_by_disk_reads", "aggregation": "raw"},
          "evaluation": {"method": "row_count", "thresholds": {"normal": {"operator": "==", "value": 0}, "warning": {"operator": ">", "value": 0}}},
          "optimization_advice": "检查 disk reads Top SQL 是否缺少索引或缓存命中率偏低"
        },
        {
          "check_id": "4.5",
          "name": "长事务",
          "priority": "P1",
          "source_module": "db_perf",
          "extract": {"json_path": "db.performance.long_transactions", "aggregation": "raw"},
          "evaluation": {"method": "row_count", "thresholds": {"normal": {"operator": "==", "value": 0}, "warning": {"operator": ">", "value": 0}}},
          "optimization_advice": "排查长事务占用 UNDO 与锁资源，确认是否存在未及时提交事务"
        },
        {
          "check_id": "4.6",
          "name": "阻塞链",
          "priority": "P0",
          "source_module": "db_perf",
          "extract": {"json_path": "db.performance.blocking_chains", "aggregation": "raw"},
          "evaluation": {"method": "row_count", "thresholds": {"normal": {"operator": "==", "value": 0}, "critical": {"operator": ">", "value": 0}}},
          "optimization_advice": "立即定位阻塞会话与被阻塞对象，避免业务持续堆积"
        },
        {
          "check_id": "4.7",
          "name": "Redo Nowait",
          "priority": "P1",
          "source_module": "db_perf",
          "extract": {"json_path": "db.performance.redo_nowait_pct", "aggregation": "raw"},
          "thresholds": {"warning": {"operator": "<", "value": 99}, "critical": {"operator": "<", "value": 95}},
          "optimization_advice": "检查 redo buffer、日志写入压力与日志文件配置"
        },
        {
          "check_id": "4.8",
          "name": "UNDO 表空间使用率",
          "priority": "P1",
          "source_module": "db_perf",
          "extract": {"json_path": "db.performance.undo_tablespace_usage.items[*].usage_percent", "aggregation": "max"},
          "thresholds": {"warning": {"operator": ">", "value": 80}, "critical": {"operator": ">", "value": 90}},
          "optimization_advice": "检查长事务和闪回窗口设置，避免 UNDO 空间耗尽"
        },
        {
          "check_id": "4.9",
          "name": "高解析 SQL",
          "priority": "P2",
          "source_module": "db_sql",
          "extract": {"json_path": "db.sql_analysis.high_parse_count_sql", "aggregation": "raw"},
          "evaluation": {"method": "row_count", "thresholds": {"normal": {"operator": "==", "value": 0}, "warning": {"operator": ">", "value": 0}}},
          "optimization_advice": "收敛频繁硬解析 SQL，排查绑定变量与共享池复用问题"
        },
        {
          "check_id": "4.10",
          "name": "高版本 SQL",
          "priority": "P2",
          "source_module": "db_sql",
          "extract": {"json_path": "db.sql_analysis.high_version_count_sql", "aggregation": "raw"},
          "evaluation": {"method": "row_count", "thresholds": {"normal": {"operator": "==", "value": 0}, "warning": {"operator": ">", "value": 0}}},
          "optimization_advice": "检查 child cursor 暴涨、绑定不一致与执行计划抖动"
        },
        {
          "check_id": "4.11", "name": "非空闲等待平均耗时", "priority": "P1", "source_module": "db_perf",
          "extract": {"json_path": "db.performance.wait_events.items[*].avg_wait_ms", "aggregation": "max"},
          "thresholds": {"warning": {"operator": ">", "value": 10}, "critical": {"operator": ">", "value": 50}},
          "optimization_advice": "按事件检查 I/O、提交与锁等待；10/50ms 为本项目排查基线。数据是实例启动以来按累计等待排序的 Top 事件平均值，不代表当前瞬时延迟。"
        },
        {
          "check_id": "4.12", "name": "Latch 请求未命中率", "priority": "P1", "source_module": "db_perf",
          "extract": {"json_path": "db.performance.latch_miss_ratios.items[*].miss_pct", "aggregation": "max"},
          "thresholds": {"warning": {"operator": ">", "value": 1}, "critical": {"operator": ">", "value": 5}},
          "optimization_advice": "检查高 misses/gets 的 Latch 与 SQL 并发；1/5% 为本项目基线。比例使用实例启动以来累计请求，不是采样期间增量；零请求无法判断。"
        },
        {
          "check_id": "4.13", "name": "实例有限资源当前使用率", "priority": "P0", "source_module": "db_perf",
          "extract": {"json_path": "db.performance.resource_limits.items[*].usage_pct", "aggregation": "max"},
          "thresholds": {"warning": {"operator": ">", "value": 80}, "critical": {"operator": ">", "value": 90}},
          "optimization_advice": "按实例检查 processes、sessions 和 parallel_max_servers 当前值及上限，排查连接泄漏或并行任务。复用现有容量 80/90% 基线；UNLIMITED 与无效上限不能计算比例。"
        },
        {
          "check_id": "4.14", "name": "解析时间占 DB time 比例", "priority": "P1", "source_module": "db_perf",
          "extract": {"json_path": "db.performance.time_model_ratios.items[*].parse_pct", "aggregation": "max"},
          "thresholds": {"warning": {"operator": ">", "value": 10}, "critical": {"operator": ">", "value": 20}},
          "optimization_advice": "检查绑定变量、语句复用和硬解析；10/20% 为本项目基线。比例来自当前实例累计 Time Model，非当前采样增量；DB time 为零或缺失时不判断正常。"
        },
        {
          "check_id": "4.15", "name": "最近 UNDO 统计错误", "priority": "P0", "source_module": "db_perf",
          "extract": {"json_path": "db.performance.undo_stats.items[*].error_count", "aggregation": "sum"},
          "thresholds": {"normal": {"operator": "==", "value": 0}, "critical": {"operator": ">", "value": 0}},
          "optimization_advice": "请 DBA 检查采集的最近 TopN 个 UNDO 统计周期中的 ORA-01555 与空间不足记录，调整长查询、UNDO 容量或保留窗口；不是实例启动以来计数。"
        },
        {
          "check_id": "4.16", "name": "表非串行并行度", "priority": "P2", "source_module": "db_security",
          "extract": {"json_path": "db.security.table_degree_gt_one", "aggregation": "raw"},
          "evaluation": {"method": "row_count", "thresholds": {"normal": {"operator": "==", "value": 0}, "warning": {"operator": ">", "value": 0}}},
          "optimization_advice": "核对表 DEGREE 大于 1 或 DEFAULT 的业务需求；这是配置复核提示，不证明性能故障。批量任务后确认是否需恢复 NOPARALLEL。"
        },
        {
          "check_id": "4.17", "name": "索引非串行并行度", "priority": "P2", "source_module": "db_security",
          "extract": {"json_path": "db.security.indexes_degree_gt_one", "aggregation": "raw"},
          "evaluation": {"method": "row_count", "thresholds": {"normal": {"operator": "==", "value": 0}, "warning": {"operator": ">", "value": 0}}},
          "optimization_advice": "核对索引 DEGREE 大于 1 或 DEFAULT 的业务需求；索引重建后确认是否需恢复 NOPARALLEL，防止意外并行资源消耗。"
        }
      ]
    },
    {
      "dimension_id": 5,
      "name": "安全与权限",
      "checks": [
        {
          "check_id": "5.1",
          "name": "禁用约束",
          "priority": "P1",
          "source_module": "db_security",
          "extract": {"json_path": "db.security.disabled_constraints", "aggregation": "raw"},
          "evaluation": {"method": "row_count", "thresholds": {"normal": {"operator": "==", "value": 0}, "warning": {"operator": ">", "value": 0}}},
          "optimization_advice": "确认业务上是否允许长期禁用约束"
        },
        {
          "check_id": "5.2",
          "name": "禁用触发器",
          "priority": "P1",
          "source_module": "db_security",
          "extract": {"json_path": "db.security.disabled_triggers", "aggregation": "raw"},
          "evaluation": {"method": "row_count", "thresholds": {"normal": {"operator": "==", "value": 0}, "warning": {"operator": ">", "value": 0}}},
          "optimization_advice": "确认触发器禁用是否已审批并有补偿措施"
        },
        {
          "check_id": "5.3",
          "name": "高权限账号",
          "priority": "P2",
          "source_module": "db_security",
          "extract": {"json_path": "db.security.dba_role_users", "aggregation": "raw"},
          "evaluation": {"method": "row_count", "thresholds": {"warning": {"operator": ">", "value": 2}, "critical": {"operator": ">", "value": 5}}},
          "optimization_advice": "收敛 DBA/SYSDBA 账号数量并落实最小权限"
        },
        {
          "check_id": "5.4",
          "name": "过期账号",
          "priority": "P1",
          "source_module": "db_security",
          "extract": {"json_path": "db.security.expired_users", "aggregation": "raw"},
          "evaluation": {"method": "row_count", "thresholds": {"normal": {"operator": "==", "value": 0}, "warning": {"operator": ">", "value": 0}}},
          "optimization_advice": "核对过期账号是否为应急账号或废弃账号，避免影响维护作业"
        },
        {"check_id": "5.5", "name": "默认口令账号", "source_module": "db_security", "extract": {"json_path": "db.security.default_password_users", "aggregation": "raw"}, "evaluation": {"method": "row_count", "thresholds": {"critical": {"operator": ">", "value": 0}}}, "optimization_advice": "请 DBA 修改默认口令，锁定无需使用的账号；Collector 不读取口令内容。"},
        {"check_id": "5.6", "name": "弱口令配置文件策略", "source_module": "db_security", "extract": {"json_path": "db.security.weak_password_profiles", "aggregation": "raw"}, "evaluation": {"method": "row_count"}, "optimization_advice": "为开放账号设置口令验证函数、有效期和失败登录锁定；DEFAULT 限制已按默认配置文件解析。"},
        {"check_id": "5.7", "name": "PUBLIC 危险系统权限", "source_module": "db_security", "extract": {"json_path": "db.security.public_system_privileges", "aggregation": "raw"}, "evaluation": {"method": "row_count", "thresholds": {"critical": {"operator": ">", "value": 0}}}, "optimization_advice": "请 DBA 核对依赖后撤销 PUBLIC 的 ANY 及管理类系统权限，改为显式授权。"},
        {"check_id": "5.8", "name": "审计设置", "source_module": "db_security", "extract": {"json_path": "db.security.audit_trail", "aggregation": "raw"}, "thresholds": {"warning": {"operator": "==", "value": "NONE"}}, "optimization_advice": "请 DBA 启用所需审计并验证实际记录；AUDIT_TRAIL 非 NONE 仅说明传统审计配置，不能证明审计策略覆盖。"},
        {"check_id": "5.9", "name": "TDE 表空间加密", "source_module": "db_security", "extract": {"json_path": "db.security.encrypted_tablespaces", "aggregation": "raw"}, "thresholds": {"warning": {"operator": "==", "value": 0}}, "optimization_advice": "没有加密表空间，需按数据保护要求评估 TDE；本项不判断列加密，钱包状态另见明细。"},
        {"check_id": "5.10", "name": "数据库链接凭据风险", "source_module": "db_security", "extract": {"json_path": "db.security.database_links", "aggregation": "raw"}, "evaluation": {"method": "row_count"}, "optimization_advice": "固定用户名提示链接可能存储凭据，请 DBA 核对链接类型和权限并轮换凭据。DBA_DB_LINKS 不提供口令存在字段，此判断是推断，不能证明凭据存在或排除其他链接风险。"},
        {"check_id": "5.11", "name": "配置文件资源限制开关", "source_module": "db_security", "extract": {"json_path": "db.security.resource_limit", "aggregation": "raw"}, "thresholds": {"warning": {"operator": "==", "value": "FALSE"}}, "optimization_advice": "请 DBA 评估启用 RESOURCE_LIMIT，并核查各账号配置文件的会话和 CPU 等资源上限。此开关不影响口令限制。"},
        {"check_id": "5.12", "name": "配置文件无限资源上限", "source_module": "db_security", "extract": {"json_path": "db.security.unlimited_resource_profiles", "aggregation": "raw"}, "evaluation": {"method": "row_count"}, "optimization_advice": "开放账号的会话数、会话 CPU、连接时长或空闲时长无限制。请 DBA 按业务要求设置资源上限并评估启用 RESOURCE_LIMIT。"
        }
      ]
    },
    {
      "dimension_id": 6,
      "name": "备份与可恢复性",
      "checks": [
        {
          "check_id": "6.1",
          "name": "RMAN 备份记录缺失",
          "priority": "P0",
          "source_module": "db_backup",
          "extract": {"json_path": "db.backup.jobs", "aggregation": "raw"},
          "evaluation": {"method": "row_count", "thresholds": {"normal": {"operator": ">", "value": 0}, "critical": {"operator": "==", "value": 0}}},
          "optimization_advice": "确认 RMAN 备份链路正常并保留最近成功备份记录"
