# Copy to .env at the repository root. ecosystem.config.cjs (PM2) loads it
# without overriding variables already exported. docs/deployment.md explains
# every setting.

# --- db-web (dbcheck-api) ---
DBCHECK_ADDR=127.0.0.1:8080
# The complete platform state: platform.db, tasks/, releases/. Use a
# persistent, backed-up directory, never /tmp.
DBCHECK_DATA_DIR=/var/lib/dbcheck
# Console origins allowed by CORS, comma-separated.
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# CI machine credential for POST /api/ci/releases (the publish script).
# Leave empty to keep the publish API disabled. Generate one with:
#   openssl rand -hex 32
DBCHECK_PUBLISH_TOKEN=
# DBCHECK_PYTHON_BIN=/opt/db-check/.venv/bin/python3
# DBCHECK_API_TOKEN is retired: db-web ignores it and logs a warning.

# --- web console (dbcheck-web), inlined when `npm run build` runs ---
# Unset means real; set mock only for demos without a backend.
# NEXT_PUBLIC_API_MODE=real
# Full origin of db-web as the browser reaches it. Unset: a page on :3000
# calls the same host on NEXT_PUBLIC_API_PORT (derived from DBCHECK_ADDR).
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8080
